# BusMitra Backend Configuration Environment Variables
PROJECT_NAME="BusMitra"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./data/busmitra.db"

# Security & Admin Authentication
SECRET_KEY="busmitra-super-secret-jwt-key-for-transit-system-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ESP32 IoT Device Authentication
SENSOR_API_KEY="bm-esp32-secret-key-2026"
SENSOR_TIMEOUT_SECONDS=120

# CORS Origins (Comma separated or *)
CORS_ORIGINS="*"

# Crowd Occupancy Thresholds (Percentage %)
CROWD_LOW_THRESHOLD=40.0
CROWD_MOD_THRESHOLD=75.0
CROWD_HIGH_THRESHOLD=100.0

# Demo Mode (True = Loads demo buses and realistic seeds without overwriting)
DEMO_MODE=True
